#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define U_BASE   0
#define U_FUN    1
#define U_MOUSE  2
#define U_SCROLL 3
#define U_SNIPE  4
#define U_MEDIA  5
#define U_NAV    6
#define U_NUM    7
#define U_SYM    8
#define U_BUT    9

&lt {
    flavor = "balanced";
    tapping-term-ms = <220>;
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";   /* 优先判定为 Tap (字母)，大幅减少打字误触 */
            tapping-term-ms = <180>;    /* 按住超过 180ms 判定为长按 (修饰键) */
            quick-tap-ms = <150>;       /* 连续快速双击时，第二次直接输入字母，方便快速打重复字母 */
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // 自定义：长按切层/开关层，短按发送键值
        ht_tog: hold_tap_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";   /* 按住超过 tapping-term-ms 即判定为长按 */
            tapping-term-ms = <200>;     /* 长按判定时间，可按习惯调整 (如 180~250ms) */
            quick-tap-ms = <150>;
            bindings = <&tog>, <&kp>;    /* 参数1给 &tog (Hold)，参数2给 &kp (Tap) */
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // layer 0 (U_BASE)
        QWERTY {
            bindings = <
&kp CAPS         &kp N1       &kp N2      &kp N3        &kp N4            &kp N5            &kp N6           &kp N7          &kp N8       &kp N9      &kp N0           &ht_tog U_MOUSE DEL
&kp TAB          &kp Q        &kp W       &kp E         &kp R             &kp T             &kp Y            &kp U           &kp I        &kp O       &kp P            &kp BSLH
&kp ESC          &hm LGUI A   &hm LALT S  &hm LCTRL D   &hm LSHFT F       &kp G             &kp H            &hm RSHFT J     &hm RCTRL K  &hm RALT L  &hm RGUI SEMI    &kp SQT
&lt U_BUT LSHFT  &kp Z        &kp X       &kp C         &kp V             &kp B             &kp N            &kp M           &kp COMMA    &kp DOT     &lt U_BUT FSLH   &kp RSHFT
                                          &mt LCTRL ESC &lt U_MOUSE SPACE &lt U_NAV TAB     &lt U_SYM BSPC   &lt U_NUM ENTER
                                                        &mo U_RNUM        &mo U_RSYM        &lt U_FUN DELETE
            >;
        };

        // layer 1 (U_FUN)
        function-layer {
            bindings = <
&kp F1  &kp F2    &kp F3   &kp F4     &kp F5     &kp F6        &kp F7     &kp F8       &kp F9        &kp F10       &kp F11    &kp F12
&none   &kp F12   &kp F7   &kp F8     &kp F9     &kp PSCRN     &none      &none        &kp LBKT      &kp RBKT      &kp MINUS  &kp EQUAL
&none   &kp F11   &kp F4   &kp F5     &kp F6     &kp SLCK      &none      &kp RSHFT    &kp RCTRL     &kp RALT      &kp RGUI   &none 
&none   &kp F10   &kp F1   &kp F2     &kp F3     &none         &none      &mo U_MEDIA  &none         &none         &none      &none 
                           &kp K_APP  &kp SPACE  &kp TAB       &none      &none
                                      &none      &none         &none 
            >;
        };

        // layer 2 (U_MOUSE)
        mouse-layer {
            bindings = <
&none     &none      &none     &none      &none       &none        &none        &none       &none       &none        &none       &to U_BASE
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &kp K_REDO   &kp K_PASTE &kp K_COPY  &kp K_CUT    &kp K_UNDO  &none
&none     &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT   &mkp LCLK    &mkp MCLK    &mkp LCLK   &mkp RCLK   &mo U_SCROLL &mo U_SNIPE &none
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &none        &none       &none       &none        &none       &none
                               &mkp MCLK  &mkp LCLK   &mkp RCLK    &mkp RCLK    &mkp LCLK
                                          &none       &none        &mkp MCLK
            >;
        };

        // layer 3 (U_SCROLL)
        scroll-layer {
            bindings = <
&none     &none      &none     &none      &none       &none        &none        &none       &none       &none     &none       &to U_BASE
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &kp K_REDO   &kp K_PASTE &kp K_COPY  &kp K_CUT &kp K_UNDO  &none
&none     &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT   &mkp LCLK    &mkp MCLK    &mkp LCLK   &mkp RCLK   &none     &none       &none
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &none        &none       &none       &none     &none       &none
                               &mkp MCLK  &mkp LCLK   &mkp RCLK    &mkp RCLK    &mkp LCLK
                                          &none       &none        &mkp MCLK
            >;
        };
        // layer 4 (U_SNIPE)
        snipe-layer {
            bindings = <
&none     &none      &none     &none      &none       &none        &none        &none       &none       &none     &none       &to U_BASE
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &kp K_REDO   &kp K_PASTE &kp K_COPY  &kp K_CUT &kp K_UNDO  &none
&none     &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT   &mkp LCLK    &mkp MCLK    &mkp LCLK   &mkp RCLK   &none     &none       &none
&none     &none      &none     &mkp RCLK  &mkp LCLK   &mkp MCLK    &none        &none       &none       &none     &none       &none
                               &mkp MCLK  &mkp LCLK   &mkp RCLK    &mkp RCLK    &mkp LCLK
                                          &none       &none        &mkp MCLK
            >;
        };

        // layer 5 (U_MEDIA)
        media-layer {
            bindings = <
&bt BT_NXT       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &none  &none     &none     &none     &none     &none 
&none            &none           &none           &none         &none         &none                 &none  &none     &none     &none     &none     &none 
&bt BT_CLR       &kp C_PREV      &kp C_VOL_DOWN  &kp C_VOL_UP  &kp C_NEXT    &kp C_VOICE_COMMAND   &none  &kp RSHFT &kp RCTRL &kp RALT  &kp RGUI  &none
&bt BT_CLR_ALL   &none           &none           &none         &none         &none                 &none  &none     &none     &none     &none     &none 
                                                 &kp C_STOP    &kp C_PP      &kp C_MUTE            &none  &none 
                                                               &kp C_BRI_DN  &kp C_BRI_UP          &none 
            >;
        };

        // layer 6 (U_NAV)
        navigation-layer {
            bindings = <
&none  &none      &none     &none      &none      &none          &none        &none       &none      &none      &none      &none
&none  &none      &none     &none      &none      &none          &kp K_REDO   &kp K_PASTE &kp K_COPY &kp K_CUT  &kp K_UNDO &none
&none  &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT  &none          &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT  &kp CAPS   &none
&none  &none      &none     &none      &none      &none          &kp HOME     &kp PG_DN   &kp PG_UP  &kp END    &kp INS    &none
                            &none      &none      &none          &kp BSPC     &kp ENTER   
                                       &none      &none          &kp DELETE
            >;
        };
        // layer 7 (U_NUM - 左手数字)
        number-layer {
            bindings = <
&none  &none      &none     &none      &none      &none          &none        &none       &none      &none      &none      &none
&none  &kp LBKT   &kp N7    &kp N8     &kp N9     &kp RBKT       &none        &none       &none      &none      &none      &none
&none  &kp SEMI   &kp N4    &kp N5     &kp N6     &kp EQUAL      &kp RSHFT    &kp RCTRL   &kp RALT   &kp RGUI   &none      &none
&none  &kp GRAVE  &kp N1    &kp N2     &kp N3     &kp BSLH       &none        &none       &none      &none      &none      &none
                            &kp DOT    &kp N0     &kp MINUS      &none        &none 
                                       &none      &none          &none
            >;
        };
        // layer 8 (U_SYM - 左手符号)
        symbol-layer {
            bindings = <
&none  &none      &none     &none      &none      &none          &none        &none       &none      &none      &none      &none
&none  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC       &none        &none       &none      &none      &none      &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS       &kp RSHFT    &kp RCTRL   &kp RALT   &kp RGUI   &none      &none
&none  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE       &none        &none       &none      &none      &none      &none
                            &kp LPAR   &kp RPAR   &kp UNDER      &none        &none 
                                       &kp LBKT   &kp RBKT       &none
            >;
        };
        // layer 9 (U_BUT) 
        button-layer {
            bindings = <
&none  &none         &none         &none          &none          &none            &none          &none          &none          &none         &none            &none
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY     &kp K_PASTE    &kp K_REDO       &kp K_REDO     &kp K_PASTE    &kp K_COPY     &kp K_CUT     &kp K_UNDO       &none
&none  &kp LGUI      &kp LALT      &kp LCTRL      &kp LSHFT      &none            &none          &kp RSHFT      &kp RCTRL      &kp RALT      &kp RGUI         &none
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY     &kp K_PASTE    &kp K_REDO       &kp K_REDO     &kp K_PASTE    &kp K_COPY     &kp K_CUT     &kp K_UNDO       &none
                                   &mkp MCLK      &mkp LCLK      &mkp RCLK        &mkp RCLK      &mkp LCLK
                                                  &none          &none            &mkp MCLK
            >;
        };

        // layer 10 (U_RNUM - 右手九宫格数字)
        right-number-layer {
            bindings = <
&none  &none      &none     &none      &none      &none          &none        &none       &none      &none      &none      &none
&none  &none      &none     &none      &none      &none          &kp LBKT     &kp N7      &kp N8     &kp N9     &kp RBKT   &none
&none  &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT  &none          &kp EQUAL    &kp N4      &kp N5     &kp N6     &kp SEMI   &none
&none  &none      &none     &none      &none      &none          &kp BSLH     &kp N1      &kp N2     &kp N3     &kp GRAVE  &none
                            &none      &none      &none          &kp MINUS    &kp N0
                                       &none      &none          &kp DOT
            >;
        };

        // layer 11 (U_RSYM - 右手符号)
        right-symbol-layer {
            bindings = <
&none  &none      &none     &none      &none      &none          &none        &none       &none      &none      &none      &none
&none  &none      &none     &none      &none      &none          &kp LBRC     &kp AMPS    &kp ASTRK  &kp LPAR   &kp RBRC   &none
&none  &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT  &none          &kp PLUS     &kp DLLR    &kp PRCNT  &kp CARET  &kp COLON  &none
&none  &none      &none     &none      &none      &none          &kp PIPE     &kp EXCL    &kp AT     &kp HASH   &kp TILDE  &none
                            &none      &none      &none          &kp UNDER    &kp RPAR
                                       &none      &none          &kp LPAR
            >;
        };
    };
};